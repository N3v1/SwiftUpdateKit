*.swp
*.lock
*.tmp

# Private credentials or environment files
.netrc
.env
.env.*

# Archives and installers
*.ipa
*.dmg
*.app

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# SwiftPM cache (optional, if you want)
/Packages/

